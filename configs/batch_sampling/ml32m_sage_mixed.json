{
  "data": {
    "dataset": "ml32m",
    "root": "/home/milnner00/projects/gnn_recsys/data/ml-32m",
    "leave_k": 10,
    "load_edge_ts": false,
    "feature_dim": null
  },
  "sampler": {
    "ratio": 1,
    "negative_sampling": "mixed",
    "perm_ratio": 0.5,
    "filter_false_negatives": false
  },
  "model": {
    "name": "hetero_sage",
    "hidden_channels": 128,
    "num_layers": 2,
    "dropout": 0.1,
    "hetero_aggr": "mean",
    "conv_aggr": "mean",
    "activation": "relu",
    "normalize_conv": true,
    "normalize_output": false,
    "input_proj": true
  },
  "optimizer": {
    "name": "adam",
    "lr": 0.001,
    "weight_decay": 0.0,
    "betas": [0.9, 0.999],
    "grad_clip": 5.0
  },
  "train": {
    "batch_size": 90000,
    "num_epochs": 1000,
    "l2_reg": 0.0001,
    "num_workers": 4,
    "seed": 42
  },
  "eval": {
    "k": 10,
    "eval_mode": "full_graph",
    "num_neighbors": [50, 25, 15],
    "num_negatives": 100,
    "eval_batch_size": 4096,
    "eval_every": 1
  },
  "early_stop": {
    "patience": 100,
    "patience_metric": "ndcg@{k}",
    "patience_mode": "max",
    "min_delta": 0.0001
  },
  "log_every": 1
}